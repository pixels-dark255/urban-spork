# Urban Spork - environment configuration.
# Copy to .env and fill in. NEVER commit .env (it is git-ignored).

# --- News (optional) -------------------------------------------------------
# Free key from https://newsapi.org/register. Without it the app falls back
# to keyless Google News RSS.
NEWS_API_KEY=

# --- Storage ---------------------------------------------------------------
# Local SQLite database holding collected bars, predictions and paper trades.
# Defaults to backend/data/urban_spork.db.
# MARKET_DB_PATH=/absolute/path/to/urban_spork.db
# MODEL_DIR=/absolute/path/to/models

# Postgres for the legacy watchlist store (free tier at supabase.com or
# neon.tech). Leave unset to use a local JSON file.
DATABASE_URL=

# --- Market data provider --------------------------------------------------
# "yahoo" (default, keyless) or "kotak_neo" (stub - see providers/kotak_neo.py)
MARKET_DATA_PROVIDER=yahoo

# --- Kotak Neo (optional, not implemented yet) -----------------------------
# Broker credentials belong here and ONLY here - never in source, never in
# a commit. The provider reports itself unavailable unless these are set AND
# the neo_api_client SDK is installed.
KOTAK_NEO_CONSUMER_KEY=
KOTAK_NEO_CONSUMER_SECRET=
KOTAK_NEO_ACCESS_TOKEN=
KOTAK_NEO_MOBILE=
KOTAK_NEO_PASSWORD=
KOTAK_NEO_MPIN=
KOTAK_NEO_ENVIRONMENT=prod

# --- Risk defaults (per-user values are set in the Settings tab) -----------
DEFAULT_CAPITAL=100000
DEFAULT_RISK_PER_TRADE_PCT=1.0
DEFAULT_MAX_DAILY_LOSS_PCT=3.0
DEFAULT_MIN_RISK_REWARD=1.5

# Below this confidence the engine returns NO TRADE rather than guessing.
MIN_TRADE_CONFIDENCE=0.55

# --- Scheduler -------------------------------------------------------------
TICK_MINUTES=5
COLLECTOR_MINUTES=5
UNIVERSE_REFRESH_HOURS=24
