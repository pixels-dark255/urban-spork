# Copy to backend/.env and fill in. Never commit the filled-in file -
# DATABASE_URL contains a password.

# Postgres. Required for the Arena: without it every store is a JSON file
# under backend/data/, which Render wipes on every sleep and redeploy, and
# which the scheduled runner refuses outright (it would write results into
# a CI container that is deleted when the job ends).
# Free options: neon.tech, supabase.com. Keep ?sslmode=require.
DATABASE_URL=

# Who advances the Strategy Arena.
#   github     the scheduled GitHub Actions job owns it; this process is a
#              read-only dashboard. The default, and what Render runs.
#   inprocess  this process ticks the arenas itself - for running the whole
#              thing on one machine.
ARENA_RUNNER=inprocess

# Optional. Without it, news falls back to keyless Google News RSS.
NEWS_API_KEY=

# Scheduler cadence for the watchlist and intraday features, in minutes.
TICK_MINUTES=5
