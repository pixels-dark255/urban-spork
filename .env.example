# Copy to .env and fill in. .env is git-ignored and is never read, printed
# or logged by the application or by any agent working on it.
# Every value below is deliberately empty: type your own, by hand.

# Postgres connection string for arena + watchlist persistence.
# Without it the app falls back to a local JSON file, which the scheduled
# runner refuses to use (see backend/run_daily.py).
DATABASE_URL=

# Optional. Company-news lookups in backend/data_sources.py.
# The app runs without it; news is simply omitted.
NEWS_API_KEY=

# Who advances the arena: "github" (the scheduled Actions runner) or
# "inprocess" (this process's own APScheduler). Default: github.
ARENA_RUNNER=

# Minutes between in-process scheduler ticks. Only read when
# ARENA_RUNNER=inprocess. Default: 5.
TICK_MINUTES=
