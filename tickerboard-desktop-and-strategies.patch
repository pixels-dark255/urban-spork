+
+
+def test_intraday_momentum_enters_at_1415_only():
+    day1 = np.full(75, 100.0)
+    day2 = list(np.linspace(100, 101, 6)) + list(np.linspace(101, 102, 69))   # +1% by 09:45
+    df = two_days(day1, day2)
+    st = engine.new_state(cfg(["intraday_momentum"]))
