+
+
+def test_gap_fade_shorts_a_failing_gap_up():
+    day1 = np.full(75, 100.0)
+    day2 = [101.5, 101.6, 101.4, 101.0, 100.8, 100.6] + list(np.linspace(100.5, 99.8, 69))
+    df = two_days(day1, day2)
